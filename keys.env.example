# 复制成 keys.env（该文件已被 .gitignore 忽略），或直接 export 到环境变量。
# 语音：https://audio.latent.moe/keys —— 前缀 lat_tk_
LATENT_AUDIO_KEY=lat_tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 图像：https://latent.moe/dashboard/keys —— 前缀 lat_sk_
LATENT_IMAGE_KEY=lat_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：只在 `voices`（列音色库）时需要。浏览器登录 audio.latent.moe 后，
# 从开发者工具的 Network → 任意请求 → Request Headers → Cookie 整段复制过来。
# 合成与出图不需要这一行。
# LATENT_COOKIE=__Secure-authjs.session-token=...; cf_clearance=...
